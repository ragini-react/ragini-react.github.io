# Canonical origin used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://walkover.in

# Sub-path the static site is served from. Empty for a domain root.
# Example for a GitHub Pages project site: BASE_PATH=/walkover-website
BASE_PATH=

# Set to "1" on staging/preview builds: every page gets noindex and robots.txt disallows all.
NEXT_PUBLIC_NOINDEX=

# Where the contact form POSTs JSON from the browser (must allow CORS).
# Without it the form opens a pre-filled email to info@walkover.in instead.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Where the Happiness Newsletter form POSTs JSON { email, consent } (must allow CORS).
# Without it (and without NEXT_PUBLIC_MAILCHIMP_URL) the form never claims a subscription.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# Alternative: a Mailchimp embedded-form action URL (…list-manage.com/subscribe/post?u=…&id=…).
# walkover.in once had one for the Happiness letter (commented out in its HTML). Confirm the list
# is active before setting it. Without either variable the form offers an email request instead.
NEXT_PUBLIC_MAILCHIMP_URL=
