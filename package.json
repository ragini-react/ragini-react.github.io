{
  "name": "walkover-sketchbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.ts tests/*.test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "prebuild": "node scripts/fetch-jobs.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright-core": "^1.64.1",
    "sass": "1.105.2",
    "typescript": "^5"
  }
}
